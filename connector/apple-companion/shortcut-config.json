{
  "schema": "agentone.apple-companion/v1",
  "instance": "Günni",
  "baseUrl": "https://guenni.mwart.solutions",
  "pairEndpoint": "/agentone/companion/confirm",
  "legacyPairEndpoint": "/agentone/companion/redeem",
  "statusEndpoint": "/agentone/companion/status",
  "ingestEndpoint": "/agentone/companion/ingest",
  "deviceTokenHeader": "X-AgentOne-Device-Token",
  "scopes": [
    "health.summary",
    "location.temporary",
    "calendar.read",
    "reminders.read",
    "shortcuts.invoke"
  ],
  "privacy": {
    "rawHealthStored": false,
    "locationTtlMaxMinutes": 60,
    "backgroundTracking": false
  }
}
