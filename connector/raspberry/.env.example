# Einmaliger Tailscale Auth-Key; nach erfolgreicher Anmeldung im Tailscale-Admin widerrufen.
TAILSCALE_AUTH_KEY=

# Mit `openssl rand -hex 32` erzeugen. Denselben Wert später als HOME_CONNECTOR_TOKEN in AgentOne hinterlegen.
CONNECTOR_TOKEN=

# Lokale Home-Assistant-Adresse aus Sicht des Raspberry Pi, ohne abschließenden Slash.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Home Assistant: Profil → Sicherheit → langlebiges Zugriffstoken.
HOME_ASSISTANT_TOKEN=

# Nur diese Entity-Domains werden an AgentOne geliefert. Kritische Domains wie lock/alarm_control_panel/siren bleiben blockiert.
HOME_ASSISTANT_DOMAINS=sensor,binary_sensor,weather,calendar,todo,media_player,light,climate,camera,automation,scene,script,switch,fan,cover,vacuum,humidifier,water_heater,input_boolean,input_number,input_select,number,select,button,device_tracker,person,sun

# Optional: zusätzlich auf einzelne Entity-IDs begrenzen. Leer bedeutet alle Entities der erlaubten Domains.
HOME_ASSISTANT_ENTITIES=

# Erst nach Prüfung aktivieren. Zulässig sind ausschließlich bestätigte Aktionen auf erlaubten Entities.
HOME_ASSISTANT_CONTROL_ENABLED=false

# Der für Günni sichtbare, stabile Tailnet-Endpunkt. Er bleibt stabil, solange das Tailscale-State-Volume erhalten bleibt.
CONNECTOR_INSTANCE_NAME=Günni
TAILSCALE_HOSTNAME=agentone-home-connector
TAILSCALE_DNS_NAME=agentone-home-connector.tailbece5a.ts.net
TAILSCALE_KEY_EXPIRY=2027-04-28T19:54:18Z

# Nur dieser Hostordner wird read-only in den Connector eingebunden.
HOST_SHARED_ROOT=./shared
FOLDER_GRANTS_JSON=[]
FOLDER_ALLOWED_EXTENSIONS=.txt,.md,.json,.csv,.pdf,.jpg,.jpeg,.png,.webp,.docx,.xlsx
FOLDER_MAX_BYTES=8388608

# Netzwerkzugriff besteht ausschließlich aus benannten Zielen und festen GET-Routen, niemals als freier Proxy.
NETWORK_TARGETS_JSON=[]
NETWORK_TARGET_AUTH_JSON={}
